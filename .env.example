# ==============================================================================
# AgriMind AI — Environment Configuration Specification Template (.env.example)
# Copy this file to .env and configure with your keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Default relational database (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL=sqlite:///./agrimind.db
# Optional MongoDB Atlas connection for telemetry and scale
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrimind?retryWrites=true&w=majority
MONGODB_DB_NAME=agrimind

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
SECRET_KEY=agrimind_production_jwt_secret_change_me_2026
JWT_SECRET_KEY=agrimind_production_jwt_secret_change_me_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. Google Gemini Vision API (Crop Leaf Disease Diagnosis)
# ------------------------------------------------------------------------------
# Obtain key from: https://aistudio.google.com/app/apikey (Starts with AIzaSy...)
GEMINI_API_KEY=AIzaSy_YOUR_OFFICIAL_GOOGLE_AI_STUDIO_API_KEY_HERE
# Mode can be set to LIVE or DEMO (Defaults to LIVE when key is present, DEMO if key is missing)
GEMINI_MODE=LIVE
# Official Vision Model (gemini-2.5-flash is recommended)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Gnani AI Voice Interaction (Prisma STT v3.0 & Timbre TTS v3.0)
# ------------------------------------------------------------------------------
# Official Gnani AI credentials from https://vachana.ai
# Supported regional languages: Telugu (te-IN), Hindi (hi-IN), English (en-IN)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_API_KEY_ID=your_gnani_api_key_here
# Mode can be set to LIVE or DEMO
GNANI_MODE=LIVE
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference

# ------------------------------------------------------------------------------
# 5. Meteorology Weather Provider (Open-Meteo & OpenWeatherMap)
# ------------------------------------------------------------------------------
# AgriMind uses live Open-Meteo API by default (no key required!).
# Optional OpenWeatherMap API key for high-density historical observation:
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------------------------
# 6. Server & Production CORS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://agrimind.vercel.app,https://agrimind.netlify.app
PORT=8000
HOST=0.0.0.0
